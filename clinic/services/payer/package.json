{
  "name": "clinic-payer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
